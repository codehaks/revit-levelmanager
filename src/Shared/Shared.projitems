<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a6f21e10-2c6d-4b15-9f3a-1d4c8e5b7a90</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>LevelManager</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)App.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Command.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Api\LevelApiController.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Api\EventHandlers\CreateLevelEventHandler.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Api\EventHandlers\DeleteLevelEventHandler.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Domain\BasePointType.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Domain\Elevation.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Domain\LevelModel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\MainForm.xaml.cs">
      <DependentUpon>MainForm.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Page Include="$(MSBuildThisFileDirectory)UI\MainForm.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="$(MSBuildThisFileDirectory)Resources\logo_16.png" />
    <Resource Include="$(MSBuildThisFileDirectory)Resources\logo_32.png" />
  </ItemGroup>
</Project>
